# Admin connection used only by the migration runner. Never commit .env.
MIGRATION_DATABASE_URL=postgresql://rrit:MIGRATION_PASSWORD@HOST:5432/DATABASE
# Restricted app_runtime login used only by web/API and SSR (rrit_web).
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@HOST:5432/DATABASE
# Separate rrit_planner login (member of rrit_worker) for workers; keep it out of web/API.
WORKER_DATABASE_URL=postgresql://WORKER_USER:WORKER_PASSWORD@HOST:5432/DATABASE
# Worker queries may read and persist image bytes; keep this above the short HTTP timeout.
WORKER_DATABASE_STATEMENT_TIMEOUT_MS=60000
# Password used by the local container worker role when the app profile is enabled.
WORKER_DB_PASSWORD=
# Supabase Auth browser client configuration.
SUPABASE_URL=
SUPABASE_KEY=
# Server-only key for private Storage operations. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket used for uploaded business assets.
MEDIA_BUCKET=assets
# Maximum time allowed for a worker source-photo download.
ASSET_STORAGE_DOWNLOAD_TIMEOUT_MS=15000
# Application origin used for redirects and trusted requests.
APP_URL=http://127.0.0.1:3000
# Temporary local development shortcut; public origins always require verification.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Keep stable across deploys. Do not rotate without a data migration.
TRIAL_HASH_KEY=
# Exactly 32 random bytes encoded as base64.
META_TOKEN_KEY=
MEDIA_SIGNING_KEY=
# One platform app; each business authorizes its own page through Meta.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Public HTTPS URL, same origin as APP_URL and registered in Meta.
META_REDIRECT_URI=
# Meta Business domain verification meta-tag content
META_DOMAIN_VERIFICATION=
# Instagram Login (Instagram API with Instagram login), its own app id and secret
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# TikTok Login Kit / Content Posting API. Keep both token keys as 32 random bytes in base64.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_KEY=
OPENROUTER_VIDEO_MODEL=
# Video length the AI creative director plans within, in seconds; shot
# lengths come from the configured model. Shots blend over the crossfade.
VIDEO_MIN_SECONDS=4
VIDEO_MAX_SECONDS=8
VIDEO_CROSSFADE_SECONDS=0.5
# Fitting photos to the channel canvas: the share a crop may discard before
# the photo is extended with AI, and the join strength that counts as a seam.
PHOTO_FIT_EXACT_LOSS=0.02
PHOTO_FIT_MAX_CROP_LOSS=0.2
PHOTO_FIT_SEAM_LIMIT=3
# Prompt character limit of the video model above, when it has one (e.g. 2500).
OPENROUTER_VIDEO_PROMPT_MAX_CHARS=
# Largest resolution requested from the video model (e.g. 720p); the MP4 is still delivered at the brief canvas.
OPENROUTER_VIDEO_MAX_RESOLUTION=
# Music model laid under each finished video (e.g. google/lyria-3-clip-preview); unset keeps videos silent.
OPENROUTER_MUSIC_MODEL=
# Enable only on an always-running Node server with the public HTTPS origin ready.
PUBLISHING_ENABLED=false
# Set true on the web process when a separate publisher must be healthy for readiness.
PUBLISHING_REQUIRED=false
# web, publisher, maintenance, planner or all. Use separate roles in production.
PROCESS_ROLE=all
# Bounded worker throughput. Each process handles this many jobs per poll.
PUBLISHING_BATCH_SIZE=5
PUBLISHING_POLL_INTERVAL_MS=5000
PUBLISHING_MAX_ATTEMPTS=5
# Runs policy-based cleanup with a PostgreSQL advisory lock.
MAINTENANCE_ENABLED=true
# Maintenance/publisher queries may process large retention batches. This is
# separate from the 10s HTTP request timeout and is capped by the server.
WORKER_DATABASE_STATEMENT_TIMEOUT_MS=60000
# Lets a customer activate or change a paid package without a card payment.
# Development/testing only; keep false until payments are connected.
BILLING_SELF_SERVICE_ENABLED=false
# Paddle stays disabled until a Paddle account, catalog and webhook destination
# are configured. Keep false in every environment without verified credentials.
PADDLE_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# AI provider: openai (default) or openrouter. Only the selected provider key is required.
AI_PROVIDER=openai
OPENAI_API_KEY=
# OpenRouter uses https://openrouter.ai/api/v1/responses and provider-prefixed model IDs.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution. APP_URL is used as the referer when this is blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Framic
# Model must support the selected provider's Responses API and structured outputs.
OPENAI_MODEL=
# Provider pricing and the daily breaker are configuration, in micro-euro.
AI_INPUT_MICRO_EUR_PER_MILLION_TOKENS=
AI_OUTPUT_MICRO_EUR_PER_MILLION_TOKENS=
AI_DAILY_BUDGET_MICRO_EUR=3500000
# Client-facing balance. The EUR conversion remains server-only.
AI_CREDIT_LIMIT=1000
AI_CREDIT_BUDGET_MICRO_EUR=3500000
LEGAL_OPERATOR_NAME=AtomX Solutions SH.P.K.
PRIVACY_EMAIL=altin.hamza@atomx-solutions.com
SUPPORT_EMAIL=
# Transactional email used by package-expiry reminders. Leave blank to disable
# delivery while keeping the reminder setting and queue available.
RESEND_API_KEY=
EMAIL_FROM=

# Monthly studio. Enable only after migrations, worker and provider smoke tests.
AI_MONTHLY_PLANNER_ENABLED=false
# A Responses model supporting web search, strict JSON Schema and vision.
# Example: gpt-5.6-terra for OpenAI, openai/gpt-5.6-terra for OpenRouter.
AI_PLANNER_MODEL=
# Separate image editor/generator. OpenRouter example: openai/gpt-image-2.5-sunburst.
# Customer uploads remain immutable originals; generated derivatives carry provenance.
AI_IMAGE_MODEL=
AI_IMAGE_QUALITY=high
# Conservative amount reserved per image call until the provider reports exact usage.
AI_IMAGE_RESERVE_MICRO_EUR=1000000
# EUR value of one USD expressed in micro-EUR; update from an operator-approved FX source.
AI_USD_MICRO_EUR=
# Current provider prices converted to micro-EUR; configure, do not guess.
AI_PLANNER_INPUT_MICRO_EUR_PER_MILLION_TOKENS=
AI_PLANNER_OUTPUT_MICRO_EUR_PER_MILLION_TOKENS=
AI_WEB_SEARCH_MICRO_EUR_PER_CALL=
# Operator safety ceiling per business, in addition to plan entitlements.
AI_PLANNER_MONTHLY_BUDGET_MICRO_EUR=3500000
# PROCESS_ROLE=planner on a persistent worker; uses WORKER_DATABASE_URL only.
