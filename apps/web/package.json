{
  "name": "@rrit/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "db:configure-roles": "node --env-file-if-exists=../../.env scripts/configure-database-roles.mjs",
    "db:verify-runtime": "node --env-file-if-exists=../../.env scripts/verify-runtime-role.mjs",
    "db:verify-worker": "node --env-file-if-exists=../../.env scripts/verify-worker-role.mjs",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "ai:evaluate": "node --experimental-strip-types scripts/evaluate-monthly-ai.ts",
    "ai:smoke": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/smoke-monthly-ai.ts",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/speed-insights": "2.0.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/simple-icons": "1.2.100",
    "@nuxt/ui": "^4.11.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "motion-v": "2.4.2",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@iconify-json/flag": "1.2.12",
    "@nuxt/eslint": "^1.15.0",
    "@playwright/test": "^1.58.0",
    "@types/pg": "8.23.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.2.0",
    "wait-on": "9.1.0"
  }
}
