{
  "name": "rrit-marketing-workspace",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "check": "npm run toolchain:check && npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run check && npm run test:integration && npm run test:security && npm run build",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "db:configure-roles": "npm run db:configure-roles --workspace apps/web",
    "db:verify-runtime": "npm run db:verify-runtime --workspace apps/web",
    "db:verify-worker": "npm run db:verify-worker --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:unit": "npm run test:unit --workspace apps/web",
    "test:integration": "npm run test:integration --workspace apps/web",
    "test:security": "npm run test:security --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "ai:smoke": "npm run ai:smoke --workspace apps/web"
  }
}
